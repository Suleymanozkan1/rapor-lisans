# Bu dosya yalnızca değişken adlarını gösterir. Gerçek değerleri buraya YAZMAYIN.
# Yerel geliştirme: .env.local oluşturun (git'e girmez). Vercel: Project Settings > Environment Variables.

# Sitenin kalıcı adresi (canonical, sitemap, RSS, Open Graph). Örnek: https://ugurdurak.com
NEXT_PUBLIC_SITE_URL=

# --- Yönetim paneli girişi ---
# Kullanıcı adı (tek yönetici). Tahmin edilemez bir değer seçin ("admin", "ugur" değil):
# kullanıcı adını bilen biri başarısız denemelerle girişi 15 dakikalığına kilitleyebilir.
ADMIN_USERNAME=
# `npm run hash-password` çıktısı (scrypt:...). Parolanın kendisini değil, hash'ini yazın.
ADMIN_PASSWORD_HASH=
# En az 32 karakter rastgele değer. Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Tüm açık oturumları geçersiz kılmak için artırın (1, 2, 3...).
SESSION_VERSION=1

# --- İçerik deposu ---
# github (üretim) | local (yalnızca yerel geliştirme; Vercel'de reddedilir)
CONTENT_STORE=github
# Fine-grained personal access token: yalnızca bu depo, "Contents: Read and write" izni.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
# Depo içindeki yollar (varsayılanlar bu projenin yapısına uyar).
GITHUB_CONTENT_PATH=content
GITHUB_UPLOADS_PATH=public/uploads

# Vercel dışında, x-forwarded-for başlığını üzerine yazan bir ters vekil arkasındaysanız 1 yapın.
# Vercel'de gerekmez. Yanlışlıkla açmak hız sınırının IP sahteciliğiyle aşılmasına yol açar.
TRUST_PROXY=

# --- İsteğe bağlı: sunucusuz örnekler arasında paylaşılan giriş hız sınırı ---
# Boş bırakılırsa sınır her sunucu örneğinde bellekte tutulur.
# Kullanmadan önce sağlayıcının güncel ücretsiz kotasını ve şartlarını kontrol edin.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Mağaza (kendi ödeme sistemi): hepsi dolmadan satış açılmaz ---
# iyzico API anahtarları (Merchant Panel > Settings > Merchant Settings > API Keys).
# Bireysel hesaplarda API yoktur; şirket (iyziPOS) hesabı gerekir. Önce sandbox anahtarlarıyla deneyin.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# https://sandbox-api.iyzipay.com (deneme) veya https://api.iyzipay.com (canlı). Başka adres kabul edilmez.
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# Sipariş veritabanı: Vercel > Storage > Neon (Postgres) bağlayınca otomatik eklenir.
DATABASE_URL=
# Satılan dosyalar: Vercel > Storage > Blob, erişim "Private". Bağlayınca otomatik eklenir.
BLOB_READ_WRITE_TOKEN=
# İndirme bağlantılarını imzalar. En az 32 karakter rastgele değer, SESSION_SECRET'tan farklı.
# Değiştirirseniz müşterilere gönderilmiş tüm bağlantılar geçersiz olur.
DOWNLOAD_SECRET=
# Sipariş e-postaları (Resend). MAIL_FROM, Resend'de doğrulanmış alan adınızdan olmalı.
RESEND_API_KEY=
MAIL_FROM="Güvenli Çalış <siparis@alanadiniz.com>"

# --- Yalnızca yerel geliştirme (Vercel'de yok sayılır) ---
# ORDER_DB=pglite            siparişleri yerel PGlite veritabanında tutar (ORDER_DB_DIR klasörü)
# PRIVATE_FILES_DIR=.private-files   ürün dosyaları için yerel klasör
